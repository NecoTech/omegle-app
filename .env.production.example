# Production env vars. On the VPS, copy to .env.production (next build/start reads
# this automatically) and fill in your real domain. Do not commit the real file.

# With the Nginx setup in deploy/nginx.conf.example, the signaling server is reverse
# proxied on the SAME domain/port as the web app (at /socket.io/), so this should be
# your site's public URL, not a separate host/port.
NEXT_PUBLIC_SIGNALING_URL=https://yourdomain.com

# Optional TURN server — strongly recommended for production. Without one, users
# behind symmetric NATs/corporate firewalls (a meaningful fraction of real traffic)
# will fail to connect even though signaling succeeds. See DEPLOYMENT.md.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Used by server.js directly (set in ecosystem.config.js, not read from this file
# unless you load it there yourself). Listed here for reference.
# CORS_ORIGIN=https://yourdomain.com
# HOST=127.0.0.1
# PORT=3001
