# URL of the Socket.IO signaling server, used by the browser client.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# Comma-separated list of origins allowed to connect to the signaling server (server.js).
CORS_ORIGIN=http://localhost:3000

# Optional TURN server for users behind restrictive NATs/firewalls where STUN alone
# can't establish a peer connection. Leave unset to use STUN only.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
